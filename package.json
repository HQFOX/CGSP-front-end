{
	"name": "cgsp-front-end",
	"version": "1.0.1",
	"private": true,
	"engines": {
		"node": "26.x"
	},
	"scripts": {
		"dev": "next dev",
		"dev:prod": "dotenv -e .env.production -- next dev",
		"build": "next build",
		"start": "next start",
		"test": "vitest",
		"test:e2e": "playwright test",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"knip": "knip",
		"format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc.json --end-of-line lf",
		"format:check": "prettier --check './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc.json --end-of-line lf",
		"docker-build": "npm run build && docker build -t nextapp .",
		"docker-push": "npm run docker-build && docker image push hqfox/nextapp",
		"size": "size-limit",
		"gen:api": "orval --config orval.config.ts",
		"generate": "npm run gen:api && npm run format"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@emotion/css": "^11.13.5",
		"@emotion/react": "^11.13.5",
		"@emotion/styled": "^11.13.5",
		"@mui/icons-material": "^9.5.0",
		"@mui/material": "^9.5.0",
		"@next/third-parties": "^16.2.10",
		"@number-flow/react": "^0.6.0",
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-query": "^5.106.1",
		"@tanstack/react-table": "^8.21.3",
		"echarts": "^6.1.0",
		"formik": "^2.4.9",
		"i18next": "^26.3.6",
		"js-cookie": "^3.0.8",
		"jwt-decode": "^4.0.0",
		"leaflet": "^1.9.4",
		"next": "^16.2.10",
		"next-i18next": "^16.4.4",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-i18next": "^17.0.16",
		"react-intersection-observer": "^11.0.1",
		"react-leaflet": "^4.2.1",
		"sharp": "^0.35.5",
		"yup": "^1.7.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.2.3",
		"@next/bundle-analyzer": "^16.4.2",
		"@playwright/test": "^1.64.1",
		"@size-limit/file": "^12.1.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.4",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/js-cookie": "^3.0.6",
		"@types/leaflet": "^1.9.21",
		"@types/node": "26.6.3",
		"@types/react": "18.3.12",
		"@types/react-dom": "18.3.1",
		"@vitejs/plugin-react": "^6.0.4",
		"dotenv": "^17.4.2",
		"dotenv-cli": "^11.0.0",
		"eslint": "9.39.5",
		"eslint-config-next": "^16.4.3",
		"jsdom": "^30.0.1",
		"knip": "^6.44.1",
		"orval": "^8.44.0",
		"prettier": "^3.9.10",
		"size-limit": "^12.1.0",
		"typescript": "6.0.2",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"conventional-changelog-conventionalcommits": "^9.0.0",
		"react-is": "^18.3.1"
	}
}
